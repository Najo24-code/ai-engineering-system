# Dependencias
node_modules/

# Estado de runtime (nunca versionar: puede contener transcripts y credenciales)
oc.db
*.db
.opencode/node_modules/
.opencode/.claude/

# Artefactos de sesión de Claude Code
.claude/.cc-writes/

# Logs y auditorías locales sin consolidar
*.jsonl
*.log

# Entorno
.env
.env.*
!.env.example

# Temporales del banco de fronteras (core/verification/boundary.mjs)
lab/.opencode/agents/__bp_*.md
lab/boundary-probe-*.txt

# Corridas del flujo (evidencia local, no versionada)
runs/

# La evidencia citada por una auditoria SI se versiona: sin ella el informe
# es una afirmacion sin respaldo.
!docs/audits/evidence/*.jsonl

# El plugin instalado se GENERA (runtimes/opencode/sync.mjs) con la ruta de la
# politica resuelta a absoluta: pertenece a una maquina concreta, no al
# repositorio. El canonico vive en runtimes/opencode/plugins/.
lab/.opencode/plugins/policy-gate.ts
